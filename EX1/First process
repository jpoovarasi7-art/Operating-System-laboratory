#include<stdio.h>
#include<unistd.h>
#include<sys/wait.h>
int main()
{
   pid_t pid;
   pid=fork();
   if(pid>0)
   {
      wait(NULL);
      printf("p1 PID = %d\n",getpid());
   }
   else if(pid==0){
      printf("p2 PID = %d , parent PID = %d\n",getpid(),getppid());
   }
   else{
      perror("fork error");
   }
   return 0;
}
