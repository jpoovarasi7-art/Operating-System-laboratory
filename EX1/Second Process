#include<stdio.h>
#include<unistd.h>
#include<sys/wait.h>
int main()
{
   pid_t pid1,pid2;
   pid1=fork();
   if(pid1>0)
   {
      wait(NULL);
      printf("p1 PID = %d\n",getpid());
      pid2=fork();
      if(pid2==0)
      {
         printf("p3 PID = %d , parent PID = %d\n",getpid(),getppid());
      }
      else if(pid2>0)
      {
         wait(NULL);
      }
      else{
         perror("fork error");
      }
   }
   else if(pid1==0){
      printf("p2 PID = %d , parent PID = %d\n",getpid(),getppid());
   }
   else{
      perror("fork error");
   }
   return 0;
}
