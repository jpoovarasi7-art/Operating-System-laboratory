#include<stdio.h>
#include<unistd.h>
#include<sys/wait.h>
int main()
{
   int n,i,sum=0;
   pid_t pid;
   printf("Enter n value:");
   scanf("%d",&n);
   pid=fork();
   if(pid==0)
   {
      for(i=1;i<=n;i++)
      {
         sum=sum+i;
      }
      printf("Child process\n");
      printf("Sum of first %d numbers is %d\n",n,sum);
   }
   else{
      printf("Parent process\n");
      printf("Sequence : ");
      while(n!=1){
         printf("%d\n",n);
         if(n%2==0)
         {
            n=n/2;
         }
         else{
            n=3*n+1;
         }
      }
      wait(NULL);
   }
   return 0;
}
