#include<stdio.h>
#include<unistd.h>
#include<sys/wait.h>
int main()
{
   pid_t pid,pid2;
   pid=fork();
   if(pid>0)
   {
      wait(NULL);
      printf("p1 PID = %d\n",getpid());
   }
   else if(pid==0){
      printf("p2 PID = %d , parent PID = %d\n",getpid(),getppid());
      pid2=fork();
      if(pid2==0)
      {
         printf("p3 PID = %d , parent PID = %d\n",getpid(),getppid());
      }
      else if(pid2>0){
         wait(NULL);}
      else{
         perror("fork error");}
   }
   else{
      perror("fork error");
   }
   return 0;
}
