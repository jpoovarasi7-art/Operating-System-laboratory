#include <stdio.h>
#include<limits.h>
#include <stdbool.h>
#include "header.h"
int i,j;
void compute_tat_wt(Process p[], int n) {
    for (i = 0; i < n; i++) {
        p[i].turnaround = p[i].completion - p[i].arrival;
        p[i].waiting = p[i].turnaround - p[i].burst;
    }
}
void calculate_fcfs(Process p[], int n) {
    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - i - 1; j++) {
            if (p[j].arrival > p[j + 1].arrival) {
                Process temp = p[j];
                p[j] = p[j + 1];
                p[j + 1] = temp;
            }
        }
    }
    int current_time = 0;
    for ( i = 0; i < n; i++) {
        if (current_time < p[i].arrival ) {
            current_time = p[i].arrival;
        }
        current_time += p[i].burst;
        p[i].completion = current_time;
    }
    compute_tat_wt(p, n);
}
void calculate_sjf(Process p[], int n) {
    bool completed[100] = {false};
    int completed_count = 0, current_time = 0;
    while (completed_count < n) {
        int index = -1;
        int min_burst = INT_MAX;
        for (i = 0; i < n; i++) {
            if (p[i].arrival <= current_time && !completed[i]) {
                if (p[i].burst < min_burst) {
                    min_burst = p[i].burst;
                    index = i;
                }
            }
        }
        if (index != -1) {
            current_time += p[index].burst;
            p[index].completion = current_time;
            completed[index] = true;
            completed_count++;
        } else {
            current_time++;
        }
    }
    compute_tat_wt(p, n);
}
void calculate_rr(Process p[], int n) {
    int i,quant = 0;
    printf("Enter the quantum time: ");
    scanf("%d", &quant);
    for (i = 0; i < n; i++) {
        p[i].remaining = p[i].burst;
    }
    int current_time = 0;
    int completed_count = 0;
    while (completed_count < n) {
        bool process_executed = false;
        for (i = 0; i < n; i++) {
            if (p[i].arrival <= current_time && p[i].remaining > 0) {
                process_executed = true;
                if (p[i].remaining > quant) {
                    current_time += quant;
                    p[i].remaining -= quant;
                } else {
                    current_time += p[i].remaining;
                    p[i].completion = current_time;
                    p[i].remaining = 0;
                    completed_count++;
                }
            }
        }
        if (!process_executed) {
            current_time++;
          }
    }
    compute_tat_wt(p, n);
}
void print_metrics(Process p[], int n) {
    float total_tat = 0, total_wt = 0;
    int i;
    printf("\nPID\tArrival\tBurst\tPriority\tCompletion\tTurnaround\tWaiting\n");
    for (i = 0; i < n; i++) {
        total_tat += p[i].turnaround;
        total_wt += p[i].waiting;
        printf("P%d\t%d\t%d\t%d\t\t%d\t\t%d\t\t%d\n",
               p[i].id, p[i].arrival, p[i].burst,p[i].priority, p[i].completion, p[i].turnaround, p[i].waiting);
    }
    printf("\nAverage Turnaround Time: %.2f\n", total_tat / n);
    printf("Average Waiting Time: %.2f\n", total_wt / n);
}

